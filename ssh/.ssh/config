# Machine-local SSH host overrides (Tailscale hosts, personal devices, etc.)
# File not tracked — create ~/.ssh/config.local with per-machine entries.
# It must also name this machine's YubiKey key at its top, before any Host block:
#   IdentityFile ~/.ssh/id_yubikey.pub        (personal machines)
#   IdentityFile ~/.ssh/id_yubikey_work.pub   (work laptop)
# Listing only the local key keeps ssh from warning about the other one, and keeps
# the personal key off work hardware.
Include ~/.ssh/config.local

IdentitiesOnly yes

Host *.redhat.com
    User jlaska
    GSSAPIAuthentication yes

Host 10.0.*.1
    User root

Host *.fedoraproject.org fedorapeople.org
    User jlaska
    VerifyHostKeyDNS yes

Host *github.com
    User jlaska

Host 192.168.* 172.16.* 10.*
    # User root
    CheckHostIP no
    UserKnownHostsFile /dev/null
    StrictHostKeyChecking no

Host *.amazonaws.com 54.211.*
    # NOTE: not all ec2 instances allow login as 'root'
    # User root
    CheckHostIP     no
    UserKnownHostsFile      /dev/null
    StrictHostKeyChecking   no
