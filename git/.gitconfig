# signingkey is pinned to the personal signing subkey (the cert also carries a work
# signing subkey); machines override via ~/.gitconfig.local.
[user]
    name = James Laska
    email = 1051173+jlaska@users.noreply.github.com
    signingkey = CC27416519C35FF9!
[color]
    diff = auto
    status = auto
    branch = auto
    interactive = auto
[alias]
    quicklog = log --pretty=format:"%h %cr %cn %Cgreen%s%Creset"
    ci = commit -v
    slog = "!sh -c 'git log --no-merges $1 `ls | grep -v ^po`' -"
[core]
    editor = vim
[push]
    default = simple
[help]
    autocorrect = 1
[commit]
    gpgsign = true
[pull]
    rebase = true
[oh-my-zsh]
    hide-status = 1
    hide-info = 1
    hide-dirty = 1
[tag]
    gpgSign = true
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
# Machine-local and untracked; must stay last so it overrides the settings above.
[include]
    path = ~/.gitconfig.local
