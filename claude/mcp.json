{
  "github": {
    "type": "http",
    "url": "https://api.githubcopilot.com/mcp",
    "headers": {
      "Authorization": "Bearer ${GITHUB_COPILOT_BEARER_TOKEN}"
    }
  },
  "linkedin": {
    "command": "uv",
    "args": ["--directory", "${HOME}/Projects/linkedin-mcp-server", "run", "-m", "linkedin_mcp_server"]
  }
}
