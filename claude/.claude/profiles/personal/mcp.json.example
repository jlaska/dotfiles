{
  "github": {
    "type": "http",
    "url": "https://api.githubcopilot.com/mcp",
    "headers": {
      "Authorization": "Bearer GITHUB_PAT_HERE"
    }
  },
  "linkedin": {
    "type": "stdio",
    "command": "uv",
    "args": ["--directory", "/Users/USERNAME/Projects/linkedin-mcp-server", "run", "-m", "linkedin_mcp_server"]
  }
}
