{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "jira-mcp-server": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-atlassian"
      ],
      "enabled": true,
      "environment": {
        "JIRA_URL": "https://redhat.atlassian.net",
        "JIRA_USERNAME": "jlaska@redhat.com",
        "JIRA_API_TOKEN": "{env:JIRA_MCP_API_TOKEN}"
      }
    }
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm.internal.keener.us/v1"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol (ChatGPT)",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-6-luna": {
